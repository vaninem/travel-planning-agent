TRAVEL_MODEL_BASE_URL=
TRAVEL_MODEL_API_KEY=
TRAVEL_MODEL_NAME=
AMAP_WEB_KEY=
AMAP_MCP_KEY=
# With only a Web key this defaults to REST. To use that key via MCP, set AMAP_TRANSPORT=mcp.
AMAP_TRANSPORT=

# Optional Ctrip Wendao token for suggested hotel and ticket detail links.
WENDAO_API_KEY=

# Optional RollingGo Hotel MCP key for live hotel prices.
# Apply at https://travelportal-partner-center.dida.com/register?lang=zh
ROLLINGGO_API_KEY=

# Optional Booking.com Demand API credentials for hotel and attraction offers.
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=

# Web ticket verification uses the existing model and public search by default.
TRAVEL_TICKET_WEB=1
BRAVE_SEARCH_API_KEY=

# Optional path to a directory containing Markdown travel guides.
TRAVEL_GUIDE_DIR=
# auto 在以下配置齐全时启用 hybrid；也可显式选择 lexical / vector / hybrid。
TRAVEL_GUIDE_RETRIEVAL=auto
# 设为 1 时不使用系统 HTTP 代理；默认沿用环境代理。
TRAVEL_GUIDE_EMBEDDING_DIRECT=0
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_EXPECTED_DIMENSIONS=
EMBEDDING_DB_SCHEMA=travel_guide_embeddings
# 可使用外部 pgvector 服务，或通过本项目的 compose.yaml 启动独立实例。
POSTGRES_USER=travel_guides
POSTGRES_DB=travel_guides
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=55433
DATABASE_URL=postgresql://travel_guides:replace-with-local-password@127.0.0.1:55433/travel_guides

# SQLite is the default. Set this to redis and configure the URL to use Redis notifications.
TRAVEL_QUEUE=sqlite
TRAVEL_REDIS_URL=redis://127.0.0.1:6379/0
TRAVEL_DB=.runtime/travel.sqlite3
